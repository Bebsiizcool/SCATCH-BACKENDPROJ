
<%- include('./partials/header') %>

<div class="min-h-screen bg-[#F7F4EE] px-5 md:px-12 lg:px-20 py-12">

    <h1 class="text-3xl font-semibold text-[#263A33] mb-8">
        Your Shopping Cart
    </h1>

    <% if (user.cart.length === 0) { %>

        <!-- Empty Cart -->
        <div class="bg-white rounded-xl p-10 text-center shadow-sm">
            <h2 class="text-2xl font-semibold text-[#263A33]">
                Your cart is empty
            </h2>

            <p class="text-gray-500 mt-2">
                Add some products to get started.
            </p>

            <a href="/shop"
               class="inline-block mt-5 bg-[#263A33] text-white px-6 py-3 rounded-lg hover:bg-[#354C43] transition">
                Continue Shopping
            </a>
        </div>

    <% } else { %>

        <div class="flex flex-col lg:flex-row gap-8">

            <!-- All Cart Products -->
            <div class="w-full lg:w-[65%] space-y-5">

                <% user.cart.forEach(function(item) { %>

                    <div class="flex flex-col sm:flex-row overflow-hidden rounded-xl shadow-sm">

                        <!-- Product Image -->
                        <div
                            class="w-full sm:w-56 h-56 flex items-center justify-center"
                            style="background-color: <%= item.bgcolor %>;"
                        >
                            <img
                                class="h-44 object-contain"
                                src="<%= item.image %>"
                                alt="<%= item.name %>"
                            >
                        </div>

                        <!-- Product Details -->
                        <div
                            class="flex-1 p-6"
                            style="background-color: <%= item.panelcolor %>; color: <%= item.textcolor %>;"
                        >
                            <h2 class="text-xl font-semibold">
                                <%= item.name %>
                            </h2>

                            <p class="mt-3">
                                Price: Rs <%= item.price %>
                            </p>

                            <p class="mt-2">
                                Discount: Rs <%= Number(item.discount || 0) %>
                            </p>

                            <div class="mt-5 border-t border-black/10 pt-4 flex justify-between items-center">
                                <span>Product Total</span>

                                <span class="font-semibold text-lg">
                                    Rs <%= Number(item.price) - Number(item.discount || 0) %>
                                </span>
                            </div>
                        </div>

                    </div>

                <% }); %>

            </div>

            <!-- Price Breakdown -->
            <div class="w-full lg:w-[35%]">

                <div class="bg-white rounded-xl p-6 shadow-sm lg:sticky lg:top-6">

                    <h2 class="text-xl font-semibold text-[#263A33] mb-6">
                        Price Breakdown
                    </h2>

                    <div class="flex justify-between mb-4">
                        <span class="text-gray-600">Total MRP</span>

                        <span class="font-medium">
                            Rs <%= totalMRP %>
                        </span>
                    </div>

                    <div class="flex justify-between mb-4">
                        <span class="text-gray-600">Total Discount</span>

                        <span class="text-green-700">
                            - Rs <%= totalDiscount %>
                        </span>
                    </div>

                    <div class="flex justify-between mb-4">
                        <span class="text-gray-600">Platform Fee</span>

                        <span>Rs <%= platformFee %></span>
                    </div>

                    <div class="flex justify-between mb-4">
                        <span class="text-gray-600">Shipping Fee</span>

                        <span class="text-green-700">FREE</span>
                    </div>

                    <div class="border-t border-gray-200 pt-5 mt-5 flex justify-between gap-4">
                        <span class="text-lg font-semibold">
                            Total Amount
                        </span>

                        <span class="text-xl font-bold text-green-700">
                            Rs <%= bill %>
                        </span>
                    </div>

                    <button
                        type="button"
                        class="w-full mt-6 py-3 rounded-lg bg-[#263A33] text-white font-medium hover:bg-[#354C43] transition"
                    >
                        Proceed to Checkout
                    </button>

                    <a href="/shop"
                       class="block text-center mt-4 text-sm text-gray-500 hover:text-[#263A33]">
                        Continue Shopping
                    </a>

                </div>

            </div>

        </div>

    <% } %>

</div>

<%- include('./partials/footer') %>
