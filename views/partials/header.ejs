<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scatch - Online Bag Shop</title>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/favicon.png">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="font-["Google Sans", sans-serif]">
    <nav class="w-full px-5 py-3 flex justify-between">
        
        <a class="text-4xl  px-5" href="/shop">Scatch</a>
        <% var loggedin = typeof loggedin !== "undefined" ? loggedin : true %>
        <% if(loggedin){%>

            <div class="flex gap-5 text-lg ">
                <a href="/shop">Shop</a>
                <a href="/cart">Cart</a>
                <a href="">My Account</a>
                <a class="text-red-600" href="/users/logout">Logout</a>
    
            </div>

        <%} %>
    </nav>